# ─────────────────────────────────────────────
# Copy this to .env for local development
# Set these as Environment Variables on Render
# ─────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/nba-playoff

# JWT secret — any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# ── Email (for forgot-password) ──────────────
# Use a Gmail account with an App Password (NOT your regular Gmail password).
# How to get an App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification → App passwords
#   2. Create one for "Mail"
#   3. Paste the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=NBA Playoff Bets <your-gmail@gmail.com>

# ── The Odds API (optional but recommended) ──
# Free tier: 500 requests/month — sign up at https://the-odds-api.com
# Without this, series winner odds default to 1.9/1.9
ODDS_API_KEY=

# ── Production ────────────────────────────────
# Set NODE_ENV=production on Render (it may do this automatically)
NODE_ENV=production

# Your Render app URL — used for CORS and password-reset email links
FRONTEND_URL=https://nba-playoff-eyd5.onrender.com

# PORT is set automatically by Render — do not set it manually
